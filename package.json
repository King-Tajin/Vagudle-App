{
  "name": "android-app",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "update:web": "node scripts/update-web.js",
    "android": "pnpm run build && pnpm exec cap open android",
    "typecheck": "node scripts/typecheck.js",
    "lint": "node scripts/lint.js",
    "doctor:report": "node scripts/doctor-report.js",
    "format": "prettier --write \"overrides/**/*.{ts,tsx,js,jsx,css,html,md}\" \"scripts/*.js\" \"*.{json,js,cjs,md}\" \"android/**/*.java\" \"android/app/src/main/AndroidManifest.xml\" \"android/app/src/main/res/**/*.xml\"",
    "format:check": "prettier --check \"overrides/**/*.{ts,tsx,js,jsx,css,html,md}\" \"scripts/*.js\" \"*.{json,js,cjs,md}\" \"android/**/*.java\" \"android/app/src/main/AndroidManifest.xml\" \"android/app/src/main/res/**/*.xml\""
  },
  "dependencies": {
    "@capacitor-firebase/app": "^8.4.0",
    "@capacitor-firebase/authentication": "^8.4.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor-community/safe-area": "^8.0.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "8.0.1",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@prettier/plugin-xml": "^3.4.2",
    "prettier": "^3.9.6",
    "prettier-plugin-java": "^2.10.3",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "packageManager": "pnpm@11.24.0"
}
