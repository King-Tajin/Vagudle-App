<?xml version="1.0" encoding="utf-8" ?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>
    <item
    android:top="4dp"
    android:bottom="4dp"
    android:left="4dp"
    android:right="4dp"
  >
        <shape android:shape="rectangle">
            <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="@color/dialogPanelStart"
        android:endColor="@color/dialogPanelEnd"
      />
            <stroke android:width="3dp" android:color="@color/dialogPurple" />
        </shape>
    </item>
</layer-list>
