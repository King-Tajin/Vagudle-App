<?xml version="1.0" encoding="utf-8" ?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dialogPurplePressed" />
            <stroke android:width="2dp" android:color="@color/dialogGold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dialogPurple" />
            <stroke android:width="2dp" android:color="@color/dialogGold" />
        </shape>
    </item>
</selector>
